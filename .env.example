# LLM Provider Configuration
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenOSINT Tool Configuration
HOLEHE_API_KEY=
SHODAN_API_KEY=
IPINFO_TOKEN=
IP2LOCATION_API_KEY=
HIBP_API_KEY=

# Database
# Default is a local SQLite file, created on first run. Nothing else is needed.
DATABASE_URL=sqlite:///./data/auto_osint.db
# PostgreSQL (docker compose, or your own server):
# DATABASE_URL=postgresql://auto_osint:CHANGE_ME@localhost:5432/auto_osint
# Only docker compose needs this: it sets the database password.
POSTGRES_PASSWORD=

# Application Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Rate Limiting (per tool)
RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_REQUESTS_PER_HOUR=100

# Execution Time (in seconds)
MAX_EXECUTION_TIME=3600  # 1 hour
TIMEOUT_PER_TOOL=60  # 60 seconds per tool invocation

# Maximum Parallel Queries
MAX_CONCURRENT_QUERIES=8

# SYNINT agent binary
SYNINT_PATH=synint
SYNINT_TIMEOUT=300


# Playbook (optional override)
# PLAYBOOK_PATH=src/python/research_playbook.mdx
